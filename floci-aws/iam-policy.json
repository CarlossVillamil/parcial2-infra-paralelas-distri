{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3SoloBucketParcial2",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::parcial2-backups"
    },
    {
      "Sid": "S3SubirYLeerObjetos",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::parcial2-backups/*"
    },
    {
      "Sid": "EKSSoloClusterParcial2",
      "Effect": "Allow",
      "Action": ["eks:CreateCluster", "eks:DescribeCluster", "eks:CreateNodegroup"],
      "Resource": "arn:aws:eks:us-east-1:000000000000:cluster/parcial2-eks"
    },
    {
      "Sid": "EKSLeerNodegroupDemo",
      "Effect": "Allow",
      "Action": ["eks:DescribeNodegroup"],
      "Resource": "arn:aws:eks:us-east-1:000000000000:nodegroup/parcial2-eks/ng-demo/*"
    },
    {
      "Sid": "PasarSoloRolEKS",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::000000000000:role/eks-role"
    },
    {
      "Sid": "ECRSoloRepoParcial2Api",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DescribeRepositories",
        "ecr:ListImages",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-1:000000000000:repository/parcial2-api"
    }
  ]
}
